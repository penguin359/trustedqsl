msgid "Callsign Certificates"
msgstr "Certificats d'indicatif"

#: certtree.cpp:120
msgid "Error while accessing certificate store"
msgstr "Erreur d'accès aux certificats enregistrés"

#: certtree.cpp:131
msgid "Error parsing certificate for issuer"
msgstr "Erreur d'analyse de l'émetteur du certificat"

#: certtree.cpp:136
msgid "Error parsing certificate for call sign"
msgstr "Erreur d'analyse du certificat d'indicatif"

#: certtree.cpp:143
msgid "Error parsing certificate for DXCC entity"
msgstr "Erreur d'analyse du certificat pour l'entité DXCC"

#: certtree.cpp:203 certtree.cpp:268
msgid "Active, usable certificates"
msgstr "Certificats actifs, utilisables"

#: certtree.cpp:217
msgid "Unusable: Missing Private Key"
msgstr "Inutilisable: clé privée manquante"

#: certtree.cpp:233
msgid "Incomplete Certificates - requires a matching TQ6"
msgstr "Certificats incomplets - nécessitent un TQ6 correspondant"

#: certtree.cpp:247
msgid "Certificates replaced with a newer one"
msgstr "Certificats remplacés par un nouveau"

#: certtree.cpp:255
msgid "Certificates that have expired"
msgstr "Certificats qui ont expirés"

#: crqwiz.cpp:46
msgid "This callsign replaces my existing callsign"
msgstr "Cet indicatif remplace un indicatif existant"

#: crqwiz.cpp:47
msgid "This is my former callsign"
msgstr "C'est mon précédent indicatif"

#: crqwiz.cpp:48
msgid "I am the QSL manager for this callsign"
msgstr "Je suis le QSL manager de cet indicatif"

#: crqwiz.cpp:49
msgid "This is a club callsign"
msgstr "C'est un indicatif de radioclub"

#: crqwiz.cpp:50
msgid "This is a DXpedition callsign"
msgstr "C'est un indicatif d'expédition DX"

#: crqwiz.cpp:51
msgid "This is a special event callsign"
msgstr "C'est un indicatif d'événement spécial"

#: crqwiz.cpp:52
msgid "None of these apply"
msgstr "Aucun de ceux-ci ne s'applique"

#: crqwiz.cpp:330
msgid "This will create a new Callsign Certificate request file."
msgstr ""
"Cela crééra un nouveau fichier de demande de certificat pour l'indicatif "
"d'appel."

#: crqwiz.cpp:332
msgid ""
"Once you supply the requested information and the request file has been "
"created, you must send the request file to the certificate issuer."
msgstr ""
"Une fois que vous fournissez les informations demandées et que le fichier de "
"demande a été créé, vous devez envoyer le dossier de demande à l'émetteur du "
"certificat."

#: crqwiz.cpp:339
msgid "Certificate Issuer:"
msgstr "Émetteur du certificat :"

