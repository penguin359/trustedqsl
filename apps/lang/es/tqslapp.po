#: certtree.cpp:84 certtree.cpp:117 tqsl.cpp:1561 tqsl.cpp:7398
msgid "Callsign Certificates"
msgstr "Certyfikaty znaków wywoławczych"

#: certtree.cpp:120
msgid "Error while accessing certificate store"
msgstr "Błąd dostępu do magazynu certyfikatów"

#: certtree.cpp:131
msgid "Error parsing certificate for issuer"
msgstr "Błąd parsowania dla wystawcy certyfikatu"

#: certtree.cpp:136
msgid "Error parsing certificate for call sign"
msgstr "Błąd parsowania certyfikatu dla stacji"

#: certtree.cpp:143
msgid "Error parsing certificate for DXCC entity"
msgstr "Błąd parsowania certyfikatu dla podmiotu DXCC"

#: certtree.cpp:203 certtree.cpp:268
msgid "Active, usable certificates"
msgstr "Aktywne certyfikaty"

#: certtree.cpp:217
msgid "Unusable: Missing Private Key"
msgstr "Bezużyteczne: Brak klucza prywatnego"

#: certtree.cpp:233
msgid "Incomplete Certificates - requires a matching TQ6"
msgstr "Niekompletne certyfikaty - wymaga dopasowania TQ6"

#: certtree.cpp:247
msgid "Certificates replaced with a newer one"
msgstr "Certyfikaty zastąpione nowszymi"

#: certtree.cpp:255
msgid "Certificates that have expired"
msgstr "Certyfikaty nieaktualne"

#: crqwiz.cpp:46
msgid "This callsign replaces my existing callsign"
msgstr "Ta stacja zastępuje moje istniejącestacje"

#: crqwiz.cpp:47
msgid "This is my former callsign"
msgstr "To jest mój poprzedni znak stacji"

#: crqwiz.cpp:48
msgid "I am the QSL manager for this callsign"
msgstr "Jestem menedżerem QSL dla tego znaku"

#: crqwiz.cpp:49
msgid "This is a club callsign"
msgstr "To jest stacja klubowa"

#: crqwiz.cpp:50
msgid "This is a DXpedition callsign"
msgstr "To jest stacja ekspedycji DX"

#: crqwiz.cpp:51
msgid "This is a special event callsign"
msgstr "To jest specjalna stacja z wydarzeniem"

#: crqwiz.cpp:52
msgid "None of these apply"
msgstr "Żadne z nich nie ma zastosowania"

#: crqwiz.cpp:330
msgid "This will create a new Callsign Certificate request file."
msgstr ""
"Spowoduje to utworzenie nowego pliku żądania certyfikatu znaku wywoławczego."

#: crqwiz.cpp:332
msgid ""
"Once you supply the requested information and the request file has been "
"created, you must send the request file to the certificate issuer."
msgstr ""
"Po podaniu żądanych informacji i utworzeniu pliku żądania należy wysłać plik "
"żądania do wystawcy certyfikatu."

#: crqwiz.cpp:339
msgid "Certificate Issuer:"
msgstr "Wystawca certyfikatu:"

#: crqwiz.cpp:350 crqwiz.cpp:1817 crqwiz.cpp:1939 crqwiz.cpp:1993
