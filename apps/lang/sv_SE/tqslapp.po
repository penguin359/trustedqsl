#: certtree.cpp:120
msgid "Error while accessing certificate store"
msgstr "Fel vid åtkomst till certifikatlagringsplats"

#: certtree.cpp:131
msgid "Error parsing certificate for issuer"
msgstr "Fel vid tolkning av certifikat för certifikatutgivaren"

#: certtree.cpp:136
msgid "Error parsing certificate for call sign"
msgstr "Fel vid tolkning av certifikat för anropssignal"

#: certtree.cpp:143
msgid "Error parsing certificate for DXCC entity"
msgstr "Fel vid tolkning av certifikat för DXCC-utfärdaren"

#: certtree.cpp:203 certtree.cpp:268
msgid "Active, usable certificates"
msgstr "Aktiva, användbara certifikat"

#: certtree.cpp:217
msgid "Unusable: Missing Private Key"
msgstr "Oanvändbar: Privat nyckel saknas"

#: certtree.cpp:233
msgid "Incomplete Certificates - requires a matching TQ6"
msgstr "Ofullständiga certifikat - kräver en matchande TQ6"

#: certtree.cpp:247
msgid "Certificates replaced with a newer one"
msgstr "Certifikat som ersatts med ett nytt"

#: certtree.cpp:255
msgid "Certificates that have expired"
msgstr "Certifikat som har löpt ut"

#: crqwiz.cpp:46
msgid "This callsign replaces my existing callsign"
msgstr "Denna anropssignal ersätter min befintliga anropssignal"

#: crqwiz.cpp:47
msgid "This is my former callsign"
msgstr "Det här är min tidigare anropssignal"

#: crqwiz.cpp:48
msgid "I am the QSL manager for this callsign"
msgstr "Jag är QSL-ansvarig för detta anropssignal"

#: crqwiz.cpp:49
msgid "This is a club callsign"
msgstr "Detta är en klubbanropssignal"

#: crqwiz.cpp:50
msgid "This is a DXpedition callsign"
msgstr "Detta är en DXpedition-anropssignal"

#: crqwiz.cpp:51
msgid "This is a special event callsign"
msgstr "Detta är en anropssignal för speciella event"

#: crqwiz.cpp:52
msgid "None of these apply"
msgstr "Inget av detta gäller"

#: crqwiz.cpp:330
msgid "This will create a new Callsign Certificate request file."
msgstr "Detta skapar en ny begäran om ett Callsign Certificate."

#: crqwiz.cpp:332
msgid ""
"Once you supply the requested information and the request file has been "
"created, you must send the request file to the certificate issuer."
msgstr ""
"När du har angett den begärda informationen och den begärda filen har "
"skapats, måste du skicka filen till certifikatutfärdaren."

#: crqwiz.cpp:339
msgid "Certificate Issuer:"
msgstr "Certifikatutfärdare:"

