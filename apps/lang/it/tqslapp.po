#: crqwiz.cpp:572
msgid ""
"Date of the last QSO you made or will make using this callsign:\n"
"(Leave this date blank if this is still your valid callsign.)"
msgstr ""
"Data dell'ultimo QSO che hai fatto o che farai usando questo nominativo:\n"
"(Lascia vuota questa data se questo è ancora il tuo nominativo valido.)"

#: crqwiz.cpp:652
msgid "Zip/Postal"
msgstr "Codice postale"

#: crqwiz.cpp:657 stationdial.cpp:70
msgid "Name"
msgstr "Nome"

#: crqwiz.cpp:683
msgid "Address"
msgstr "Indirizzo"

