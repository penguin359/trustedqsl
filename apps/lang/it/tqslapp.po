msgid "Callsign Certificates"
msgstr "Certificati del nominativo"

#: certtree.cpp:120
msgid "Error while accessing certificate store"
msgstr "Errore durante l'accesso all'archivio dei certificati"

#: certtree.cpp:131
msgid "Error parsing certificate for issuer"
msgstr "Errore di analisi del certificato per l'emittente"

#: certtree.cpp:136
msgid "Error parsing certificate for call sign"
msgstr "Errore di analisi del certificato per il nominativo"

#: certtree.cpp:143
msgid "Error parsing certificate for DXCC entity"
msgstr "Errore di analisi del certificato per l'entità DXCC"

#: certtree.cpp:203 certtree.cpp:268
msgid "Active, usable certificates"
msgstr "Certificati attivi, usabili"

#: certtree.cpp:217
msgid "Unusable: Missing Private Key"
msgstr "Inusabile: Chiave privata mancante"

#: certtree.cpp:233
msgid "Incomplete Certificates - requires a matching TQ6"
msgstr "Certificati incompleti - è richiesto un TQ6 corrispondente"

#: certtree.cpp:247
msgid "Certificates replaced with a newer one"
msgstr "Certificati sostituiti con uno nuovo"

#: certtree.cpp:255
msgid "Certificates that have expired"
msgstr "Certificati che sono scaduti"

#: crqwiz.cpp:46
msgid "This callsign replaces my existing callsign"
msgstr "Questo nominativo sostituisce il mio nominativo esistente"

#: crqwiz.cpp:47
msgid "This is my former callsign"
msgstr "Questo è il mio nominativo precedente"

#: crqwiz.cpp:48
msgid "I am the QSL manager for this callsign"
msgstr "Sono il QSL manager per questo nominativo"

#: crqwiz.cpp:49
msgid "This is a club callsign"
msgstr "Questo è un nominativo di club"

#: crqwiz.cpp:50
msgid "This is a DXpedition callsign"
msgstr "Questo è il nominativo di una DXpedition"

#: crqwiz.cpp:51
msgid "This is a special event callsign"
msgstr "Questo è il nominativo per un evento speciale"

#: crqwiz.cpp:52
msgid "None of these apply"
msgstr "Nessuno di questi è applicabile"

#: crqwiz.cpp:330
msgid "This will create a new Callsign Certificate request file."
msgstr "Verrà creato un nuovo file di richiesta di certificato del nominativo."

#: crqwiz.cpp:332
msgid ""
"Once you supply the requested information and the request file has been "
"created, you must send the request file to the certificate issuer."
msgstr ""
"Una volta che le informazioni richieste saranno state fornite e che il file "
"di richiesta sarà stato creato, dovrai inviare il file di richiesta "
"all'emittente del certificato."

#: crqwiz.cpp:339
msgid "Certificate Issuer:"
msgstr "Emittente del certificato:"

