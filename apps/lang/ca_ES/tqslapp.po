#: qsodatadialog.cpp:385 stationdial.cpp:223 tqsl_prefs.cpp:67
msgid "Help"
msgstr "Ajuda"

#: getpassword.cpp:117
msgid "New passphrase:"
msgstr "Nova contrasenya :"

#: getpassword.cpp:120
msgid "Enter again to confirm:"
msgstr "Torna a entrar-la per a confirmar-la :"

#: getpassword.cpp:152
msgid "Passphrase entries do not match"
msgstr "Les entrades de la contrasenya no coincideixen"

#: getpassword.cpp:163
