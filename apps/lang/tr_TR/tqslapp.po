msgstr "Yenisi ile değiştirilmiş sertifikalar"

#: certtree.cpp:255
msgid "Certificates that have expired"
msgstr "Süresi dolmuş sertifikalar"

#: crqwiz.cpp:46
msgid "This callsign replaces my existing callsign"
msgstr "Bu çağrı işareti mevcut çağrı işaretimin yerini alıyor"

#: crqwiz.cpp:47
msgid "This is my former callsign"
msgstr "Bu benim eski çağrı işaretim"

#: crqwiz.cpp:48
msgid "I am the QSL manager for this callsign"
msgstr "Bu çağrı işareti için QSL yöneticisiyim"

#: crqwiz.cpp:49
msgid "This is a club callsign"
msgstr "Bu bir kulüp çağrı işareti"

#: crqwiz.cpp:50
msgid "This is a DXpedition callsign"
msgstr "Bu bir DXpedition çağrı işareti"

#: crqwiz.cpp:51
msgid "This is a special event callsign"
msgstr "Bu özel bir etkinlik çağrı işaretidir"

#: crqwiz.cpp:52
msgid "None of these apply"
msgstr "Bunların hiçbiri geçerli değil"

#: crqwiz.cpp:330
msgid "This will create a new Callsign Certificate request file."
msgstr "Bu menü yeni Çağrı Adı Sertifikası yaratacaktır."

#: crqwiz.cpp:332
msgid ""
"Once you supply the requested information and the request file has been "
"created, you must send the request file to the certificate issuer."
msgstr ""
"Gerekli bilgiler doldurulup, istek dosyası yaratıldıktan sonra, istek "
"dosyasını sertifika sağlayıcıya göndermeniz gerekmektedir."

#: crqwiz.cpp:339
msgid "Certificate Issuer:"
msgstr "Sertifika Sağlayıcısı:"

