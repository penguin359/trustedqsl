msgstr "Bu çağrı işareti ile yaptığınız ilk QSO tarihi:"

#: crqwiz.cpp:572
msgid ""
"Date of the last QSO you made or will make using this callsign:\n"
"(Leave this date blank if this is still your valid callsign.)"
msgstr ""
"Bu çağrı işareti ile yaptığınız son QSO tarihi \n"
"(Hala aktif bir çağrı işareti ise boş bırakınız)"

#: crqwiz.cpp:652
msgid "Zip/Postal"
msgstr "Posta Kodu"

#: crqwiz.cpp:657 stationdial.cpp:70
msgid "Name"
msgstr "İsim"

#: crqwiz.cpp:683
msgid "Address"
msgstr "Adres"

